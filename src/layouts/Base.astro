---
import '../styles/base.css';
import { absoluteUrl, siteBase, withBase } from '../lib/url';

interface Props {
  lang: 'en-US' | 'pt-BR' | 'zh-Hans';
  locale: 'en' | 'pt' | 'zh';
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
}
const { lang, locale, title, description, ogImage: ogImageProp, ogImageAlt: ogImageAltProp } = Astro.props;
const path = `/${locale}/`;
const canonical = absoluteUrl(path, Astro.site);
const social = {
  en: { locale: 'en_US', alternates: ['pt_BR', 'zh_CN'], imageAlt: 'Jorge smiling in front of the Chongqing skyline at night.' },
  pt: { locale: 'pt_BR', alternates: ['en_US', 'zh_CN'], imageAlt: 'Jorge sorrindo diante do horizonte de Chongqing à noite.' },
  zh: { locale: 'zh_CN', alternates: ['en_US', 'pt_BR'], imageAlt: 'Jorge 在夜晚的重庆天际线前微笑。' }
} as const;
const socialMeta = social[locale];
const ogImage = ogImageProp ?? `/og/og-${locale}.jpg`;
const ogImageAlt = ogImageAltProp ?? socialMeta.imageAlt;
const ogImageUrl = absoluteUrl(ogImage, Astro.site);
const languages = [
  { code: 'en', label: 'EN', href: '/en/' },
  { code: 'pt', label: 'PT', href: '/pt/' },
  { code: 'zh', label: '中文', href: '/zh/' }
];
---
<!doctype html>
<html lang={lang} data-site-base={siteBase}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#121110" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('/icon-192.png')} sizes="192x192" type="image/png" />
    <link rel="icon" href={withBase('/icon-512.png')} sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="preload" href={withBase('/media/intro-1-800.avif')} as="image" type="image/avif" fetchpriority="high" imagesrcset={`${withBase('/media/intro-1-480.avif')} 480w, ${withBase('/media/intro-1-800.avif')} 800w, ${withBase('/media/intro-1-3200.avif')} 3200w`} imagesizes="(min-width: 900px) 34vw, 100vw" />
    {locale !== 'zh' && <link rel="preload" href={withBase('/fonts/instrument-serif-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />}
    <link rel="canonical" href={canonical} />
    {languages.map((item) => <link rel="alternate" hreflang={item.code === 'en' ? 'en' : item.code === 'pt' ? 'pt-BR' : 'zh-Hans'} href={absoluteUrl(item.href, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl('/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={socialMeta.locale} />
    {socialMeta.alternates.map((alternate) => <meta property="og:locale:alternate" content={alternate} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <slot />
  </body>
</html>
